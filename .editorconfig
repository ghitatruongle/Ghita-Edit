# EditorConfig is useful for configuring various text editors and software plugins
# See http://editorconfig.org for more information.

root = true

# Base settings that simulate defaults
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# Flutter/Dart specific
[lib/**/*.dart]
indent_size = 2

[test/**/*.dart]
indent_size = 2

[native_engine/**/*.cpp]
indent_size = 4
tab_width = 4

[native_engine/**/*.h]
indent_size = 4
tab_width = 4

[CMakeLists.txt]
indent_size = 2
