# ==============================================================================
# Ghita Edit — Enterprise .gitignore Configuration (v1.0.0+0)
# Cross-Platform Multimedia Editor (Flutter 3.27+ & C++20 Native Engine)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OS & System Miscellaneous Files
# ------------------------------------------------------------------------------
*.class
*.swp
*.bak
*.tmp
*.temp
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*.stackdump
*.directory

# ------------------------------------------------------------------------------
# 2. Java / JVM / Flutter Crash Dumps & Diagnostic Logs
# ------------------------------------------------------------------------------
*.log
hs_err_pid*.log
replay_pid*.log
flutter_*.log
*.log.tags

# ------------------------------------------------------------------------------
# 3. App-Specific, Local Workspaces, Internal Docs & Autosaves
# ------------------------------------------------------------------------------
.ghita_autosave/
.zcode/
.history/
migrate_working_dir/
/noibo/
PLAN_*.md
PLAN_REVIEW_*.md
# Internal code-review handoff artifacts (audit exports, diff dumps)
_XEMAYDOI*
# Ad-hoc tooling dropped into the repo root (portable GitHub CLI copy etc.)
/gh_cli/
/gh.zip
# v1.5.0-T2 (P4): docs/ is TRACKED (plan_v1.5.0.md, plan_v1.5.0_final.md,
# rust_engine_abi.md, android_status.md...) — the old blanket "docs/" ignore
# made new docs silently invisible to git.
assets/logos/
assets/logo_concept*.png
*.ghita
*.ghita.json
extracted_*.png
test_*.png
*.png.tmp

# Installer Build Output (Inno Setup) — only the .iss source is committed
installer/output/
installer/*.log

# AI Coding Assistant & Agent Scratch Workspaces
.antigravityignore
.brain/
.agents/
.gemini/
.claude/
.cursor/
.copilot/
scratch/

# ------------------------------------------------------------------------------
# 4. IDEs, Code Editors & Project Workspace Settings
# ------------------------------------------------------------------------------
# JetBrains (IntelliJ IDEA, CLion, Android Studio)
*.iml
*.ipr
*.iws
.idea/
.idea_modules/

# Visual Studio & VS Code
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates
*.vcxproj.user
*.vcxproj.filters
*.VC.db
*.VC.opendb

# Xcode, Eclipse, Sublime, Atom
.atom/
.buildlog/
.svn/
.swiftpm/

# ------------------------------------------------------------------------------
# 5. Flutter / Dart / Pub Package Toolchain
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
**/build/
coverage/
**/doc/api/
*.pub

# Explicitly preserve required static assets
!assets/
!assets/logo.png

# ------------------------------------------------------------------------------
# 6. Android Native & NDK Build System
# ------------------------------------------------------------------------------
**/android/.gradle/
**/android/local.properties
**/android/captures/
**/android/.cxx/
**/android/GeneratedPluginRegistrant.java
/android/app/debug/
/android/app/profile/
/android/app/release/
/android/app/src/main/jniLibs/
**/android/app/build/
/android/app/build/

# Mobile Build Outputs (APK, AAB, iOS, macOS bundles)
*.apk
*.aab
*.ipa
*.app

# Android Signing Credentials & Keystores (Never commit to Git)
key.properties
**/*.keystore
**/*.jks
**/*.p12
**/*.pem

# ------------------------------------------------------------------------------
# 7. iOS & macOS Native Environments
# ------------------------------------------------------------------------------
**/ios/Flutter/.last_build_id
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.fltparam
**/ios/DerivedData/
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/ephemeral/
**/macos/Pods/
**/macos/Flutter/ephemeral/
**/linux/flutter/ephemeral/

# ------------------------------------------------------------------------------
# 8. C++20 Native Engine (CMake, MSVC, NDK, GCC, Clang Build Outputs)
# ------------------------------------------------------------------------------
native_engine/build/
native_engine/build_*/
native_engine/out/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeLists.txt.user
CMakePresets.json.user
CMakeUserPresets.json
compile_commands.json
.ninja_deps
.ninja_log
*.[Cc]ache
!*.[Cc]ache/

# Platform Architecture & Build Output Directories
x64/
x86/
ARM/
ARM64/
Debug/
Release/
RelWithDebInfo/
MinSizeRel/

# Negate Android source manifests caught by the Debug/ rule above
# (android/app/src/debug/AndroidManifest.xml is a REQUIRED source file)
!android/app/src/debug/
!android/app/src/profile/
!android/app/src/main/

# Compiled Object Files & Intermediate Artifacts
*.obj
*.o
*.exp
*.ilk
*.pdb
*.tlb
*.tli
*.tlh
*.sdf
*.a
*.lib

# Output Executables & Shared Dynamic Libraries
*.so
*.so.*
*.dll
*.dylib
*.exe

# Debug Symbols
*.dSYM/

# ------------------------------------------------------------------------------
# 9. Exported Media Test Files (Generated during export & render tests)
# ------------------------------------------------------------------------------
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.mp3
*.gif
*.aac
*.flac
*.raw
*.mp4.tmp
output.mp4

# ------------------------------------------------------------------------------
# 10. Symbolication & Obfuscation Maps
# ------------------------------------------------------------------------------
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# 11. Archive & Packaging Artifacts (backups, distribution bundles)
# ------------------------------------------------------------------------------
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.iso
# Release pipeline output (scripts/build_release.sh)
dist/

# ==============================================================================
# SAFEGUARDS: Explicitly Protect All Source Code Extensions
# Guarantee that no developer source files are ever accidentally ignored
# ==============================================================================
!*.dart
!*.cpp
!*.h
!*.c
!*.hpp
!*.kt
!*.java
!*.gradle
!*.kts
!*.xml
!*.yaml
!*.yml
!*.md
!*.sh
!*.bat
!*.ico
!*.rc
!.github/

# Third-party local data (FreeBun desktop DB etc.)
.freebuff/

# ------------------------------------------------------------------------------
# 12. Reference Projects (downloaded for learning purposes, not part of repo)
# ------------------------------------------------------------------------------
refer_project/

**/target/

# ------------------------------------------------------------------------------
# 13. Re-asserted Internal Ignores (MUST stay last)
# Git keeps the LAST matching pattern, so the !*.md safeguard above silently
# re-includes any .md ignored earlier. These rules close that hole.
# ------------------------------------------------------------------------------
_XEMAYDOI*
/PLAN_*.md
/PLAN_REVIEW_*.md
